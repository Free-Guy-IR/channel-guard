[Unit]
Description=Channel Guard - Telegram channel monitor + analytics panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=channelguard
Group=channelguard
WorkingDirectory=/opt/channel-guard
ExecStart=/opt/channel-guard/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
